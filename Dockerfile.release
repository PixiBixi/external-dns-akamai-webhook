# Used by goreleaser, which hands the already-built binary to the build context.
# The human-facing Dockerfile at the repo root compiles from source instead.
FROM gcr.io/distroless/static-debian12:nonroot

COPY external-dns-akamai-webhook /external-dns-akamai-webhook

# Only health and metrics. The webhook API stays on localhost.
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/external-dns-akamai-webhook"]
